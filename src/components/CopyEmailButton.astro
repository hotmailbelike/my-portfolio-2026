---
/* Renders its own list item, so callers place it directly inside a <ul>. The
   item ships hidden and copy-email.ts reveals it once copying is possible;
   without JavaScript the list shows no empty slot. */
import Icon from './Icon.astro';

interface Props {
  email: string;
  label?: string;
}

const { email, label = 'Copy email' } = Astro.props;
---

<li class="copy-email" data-copy-email={email} hidden>
  <button type="button" class="copy-email__button" data-copy-email-button>
    <Icon name="copy" class="copy-email__icon copy-email__icon--copy" />
    <Icon name="check" class="copy-email__icon copy-email__icon--check" />
    <span data-copy-email-label>{label}</span>
  </button>
  <span class="visually-hidden" aria-live="polite" data-copy-email-status></span>
</li>

<script>
  import '../scripts/copy-email';
</script>

<style>
  .copy-email[hidden] {
    display: none;
  }

  .copy-email__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: transparent;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--duration-hover) var(--ease-out), background var(--duration-hover) var(--ease-out);
  }

  .copy-email__button:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-tint);
  }

  /* The icons render inside Icon.astro, outside this component's style scope. */
  .copy-email__button :global(.copy-email__icon--check),
  .is-copied :global(.copy-email__icon--copy) {
    display: none;
  }

  .is-copied :global(.copy-email__icon--check) {
    display: block;
    color: var(--color-accent);
  }
</style>
