---
/* Small inline icons. They inherit the text color and are hidden from screen
   readers; the link or button around them carries the accessible name. */
export type IconName = 'arrow-up-right' | 'arrow-right' | 'arrow-left' | 'copy' | 'check' | 'github' | 'linkedin' | 'close';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const DEFAULT_ICON_SIZE = 16;
const { name, size = DEFAULT_ICON_SIZE, class: className } = Astro.props;

const STROKE_PATHS: Partial<Record<IconName, string>> = {
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  'arrow-left': 'M19 12H5M11 6l-6 6 6 6',
  copy: 'M9 9h10v10H9zM5 15V5h10',
  check: 'M5 12.5 10 17 19 7',
  close: 'M6 6l12 12M18 6 6 18',
};

const FILLED_PATHS: Partial<Record<IconName, string>> = {
  github:
    'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z',
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
};

const strokePath = STROKE_PATHS[name];
const filledPath = FILLED_PATHS[name];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={filledPath ? 'currentColor' : 'none'}
  stroke={strokePath ? 'currentColor' : 'none'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {strokePath && <path d={strokePath} />}
  {filledPath && <path d={filledPath} />}
</svg>
