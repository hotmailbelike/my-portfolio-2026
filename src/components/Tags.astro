---
interface Props {
  tags: string[];
  label?: string;
}

const { tags, label = 'Built with' } = Astro.props;
---

<ul class="tags" aria-label={label}>
  {tags.map((tag) => <li class="tags__item">{tag}</li>)}
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;
    list-style: none;
  }

  .tags__item {
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: var(--color-accent-tint);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.6;
  }
</style>
