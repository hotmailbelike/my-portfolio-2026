---
/* A deliberately generic view of the agent system: real structure, no
   internal names. Built from HTML rather than an image so it stays readable
   on phones and is read naturally by screen readers. */
const SPECIALIST_AGENTS = ['Design', 'Stone finder', 'Concierge', 'Pricing'];
---

<figure class="diagram">
  <ol class="diagram__flow" aria-label="How a chat request moves through the system">
    <li class="diagram__node">
      <span class="diagram__name">Chat</span>
      <span class="diagram__note">One conversation for every task</span>
    </li>
    <li class="diagram__node diagram__node--accent">
      <span class="diagram__name">Planner</span>
      <span class="diagram__note">Reads the turn, decides who acts</span>
    </li>
    <li class="diagram__group">
      <ul class="diagram__agents" aria-label="Specialist agents">
        {
          SPECIALIST_AGENTS.map((agent) => (
            <li class="diagram__node diagram__node--small">
              <span class="diagram__name">{agent}</span>
            </li>
          ))
        }
      </ul>
      <span class="diagram__note">Each agent runs its own tool loop</span>
    </li>
    <li class="diagram__node">
      <span class="diagram__name">Tool service</span>
      <span class="diagram__note">One durable receipt per AI call</span>
    </li>
    <li class="diagram__node">
      <span class="diagram__name">AI models</span>
      <span class="diagram__note">Image, text and 3D generation</span>
    </li>
  </ol>
  <figcaption class="diagram__caption">
    Simplified. State is checkpointed in PostgreSQL, long work runs on a queue, and progress streams to the browser
    in real time.
  </figcaption>
</figure>

<style>
  .diagram {
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .diagram__flow {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
    padding: 0;
    list-style: none;
  }

  .diagram__node,
  .diagram__group {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    text-align: center;
  }

  /* The connector line between one step and the next. */
  .diagram__flow > li + li::before {
    content: '';
    position: absolute;
    top: -1.5rem;
    left: 50%;
    width: 1px;
    height: 1.25rem;
    background: var(--color-border-strong);
  }

  .diagram__node:not(.diagram__node--small) .diagram__name {
    min-width: 11rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-weight: 600;
  }

  .diagram__node--accent .diagram__name {
    border-color: var(--color-accent);
    background: var(--color-accent-tint);
  }

  .diagram__agents {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .diagram__node--small .diagram__name {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: var(--text-sm);
  }

  .diagram__note {
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  .diagram__caption {
    margin-top: 1.75rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
