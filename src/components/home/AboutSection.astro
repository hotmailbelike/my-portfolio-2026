---
import { Image } from 'astro:assets';

import profilePhoto from '../../assets/profile/abdullah-omar.jpg';
import { PROFILE } from '../../data/profile';
import SectionHeading from '../SectionHeading.astro';

const PHOTO_WIDTHS = [240, 480];
---

<section class="section container" aria-labelledby="about">
  <SectionHeading id="about" index="03" title="About" />
  <div class="about">
    <div class="about__text">
      {PROFILE.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <Image
      class="about__photo"
      src={profilePhoto}
      alt={`Portrait of ${PROFILE.name}`}
      widths={PHOTO_WIDTHS}
      sizes="240px"
      format="webp"
    />
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (width >= 48rem) {
    .about {
      grid-template-columns: 1fr 15rem;
      gap: 4rem;
    }
  }

  .about__text {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
    color: var(--color-muted);
  }

  .about__text p:first-child {
    color: var(--color-text);
    font-size: var(--text-lg);
  }

  .about__photo {
    width: 100%;
    max-width: 15rem;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    filter: grayscale(1);
  }

  /* Small color moment on hover: the photo regains its color. */
  @media (prefers-reduced-motion: no-preference) {
    .about__photo {
      transition: filter 400ms var(--ease-out);
    }
  }

  .about__photo:hover {
    filter: none;
  }

  @media (width < 48rem) {
    .about__photo {
      grid-row: 1;
      max-width: 9rem;
    }
  }
</style>
