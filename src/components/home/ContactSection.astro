---
import { PROFILE } from '../../data/profile';
import EmailWithCopy from '../EmailWithCopy.astro';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
---

<section class="section container" aria-labelledby="contact">
  <SectionHeading id="contact" title="Get in touch" />
  <p class="contact__lede">Have a role, a project or a question? Email is the quickest way to reach me.</p>
  <p class="contact__email"><EmailWithCopy email={PROFILE.email} size="large" /></p>
  <ul class="contact__links">
    <li>
      <ExternalLink href={PROFILE.githubUrl} class="contact__link">
        <Icon name="github" /> GitHub
      </ExternalLink>
    </li>
    <li>
      <ExternalLink href={PROFILE.linkedinUrl} class="contact__link">
        <Icon name="linkedin" /> LinkedIn
      </ExternalLink>
    </li>
    <li>
      <ExternalLink href={PROFILE.resumeUrl} class="contact__link">
        Résumé <Icon name="arrow-up-right" size={14} />
      </ExternalLink>
    </li>
  </ul>
</section>

<style>
  .contact__lede {
    max-width: 36rem;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .contact__email {
    margin-top: 1.25rem;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  /* Flex items, so icon-first and text-first links center the same way. */
  .contact__links > li {
    display: flex;
  }

  .contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .contact__link:hover {
    color: var(--color-accent);
  }
</style>
