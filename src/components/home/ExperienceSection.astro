---
import { PUBLICATION, ROLES } from '../../data/experience';
import { PROFILE } from '../../data/profile';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import Tags from '../Tags.astro';
---

<section class="section container" aria-labelledby="experience">
  <SectionHeading id="experience" title="Experience" />

  <ol class="timeline">
    {
      ROLES.map((role) => (
        <li class="timeline__row">
          <p class="timeline__dates">
            {role.start} – {role.end}
          </p>
          <div class="timeline__body">
            <h3 class="timeline__title">
              {role.title} ·{' '}
              <ExternalLink href={role.companyUrl} class="timeline__company">
                {role.company}
              </ExternalLink>
            </h3>
            <p class="timeline__summary">{role.summary}</p>
            <Tags tags={role.tags} />
          </div>
        </li>
      ))
    }
  </ol>

  <div class="timeline__row timeline__row--extra">
    <p class="timeline__dates">{PUBLICATION.year}</p>
    <div class="timeline__body">
      <h3 class="timeline__title">
        Paper ·{' '}
        <ExternalLink href={PUBLICATION.url} class="timeline__company">
          {PUBLICATION.title}
        </ExternalLink>
      </h3>
      <p class="timeline__summary">{PUBLICATION.venue}</p>
    </div>
  </div>

  <p class="timeline__resume">
    <ExternalLink href={PROFILE.resumeUrl}>
      Full résumé <Icon name="arrow-up-right" size={14} />
    </ExternalLink>
  </p>
</section>

<style>
  .timeline {
    padding: 0;
    list-style: none;
  }

  .timeline__row {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (width >= 48rem) {
    .timeline__row {
      grid-template-columns: 11rem 1fr;
    }
  }

  .timeline__dates {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    line-height: 1.9;
  }

  .timeline__title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0;
  }

  .timeline__company {
    text-decoration-line: underline;
  }

  .timeline__summary {
    max-width: 44rem;
    margin-block: 0.375rem 0.75rem;
    color: var(--color-muted);
  }

  .timeline__row--extra .timeline__summary {
    margin-bottom: 0;
  }

  .timeline__resume {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-weight: 600;
  }

  .timeline__resume a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
</style>
