---
import { FACTS } from '../../data/profile';
---

<section class="container" aria-label="At a glance">
  <dl class="facts">
    {
      FACTS.map((fact) => (
        <div class="facts__item">
          <dt class="eyebrow">{fact.label}</dt>
          <dd class="facts__value">{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.5rem;
    border-block: 1px solid var(--color-border);
  }

  @media (width >= 48rem) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .facts__item {
    padding: 1.25rem 1rem 1.25rem 0;
  }

  .facts__item + .facts__item {
    padding-left: 1rem;
    border-left: 1px solid var(--color-border);
  }

  /* In the 2x2 layout the third item starts a new row, so it needs no divider. */
  @media (width < 48rem) {
    .facts__item:nth-child(3) {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }

    .facts__item:nth-child(4) {
      border-top: 1px solid var(--color-border);
    }
  }

  .facts__value {
    margin-top: 0.375rem;
    font-weight: 500;
  }
</style>
