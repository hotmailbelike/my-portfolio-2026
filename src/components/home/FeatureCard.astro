---
/* The FacetFlow highlight. Its screenshot shares a view-transition name with
   the case study's hero, so the image grows into the next page on click. */
import { Picture } from 'astro:assets';

import { FACETFLOW } from '../../data/projects';
import BrowserFrame from '../BrowserFrame.astro';
import Icon from '../Icon.astro';
import Tags from '../Tags.astro';

const caseStudyHref = `/work/${FACETFLOW.slug}`;
const SHOT_WIDTHS = [640, 960, 1280, 1800, 2400];
/* Approximates the card layout below: beside the text column from 56rem, full width under it. */
const SHOT_SIZES = '(min-width: 72rem) 760px, (min-width: 56rem) 57vw, calc(100vw - 4rem)';
---

<section class="feature container" aria-labelledby="feature-title">
  <article class="feature__card">
    <div class="feature__text">
      <p class="eyebrow">Featured case study · {FACETFLOW.years}</p>
      <h2 class="feature__title" id="feature-title">
        <a class="feature__link" href={caseStudyHref}>
          {FACETFLOW.name}<span class="visually-hidden"> case study</span>
        </a>
      </h2>
      <p class="feature__summary">{FACETFLOW.teaser}</p>
      <Tags tags={FACETFLOW.tags} />
      <span class="feature__cta" aria-hidden="true">
        Read the case study <Icon name="arrow-right" />
      </span>
    </div>

    <BrowserFrame class="feature__frame">
      <Picture
        class="feature__shot"
        src={FACETFLOW.hero.image}
        alt={FACETFLOW.hero.alt}
        formats={['avif', 'webp']}
        widths={SHOT_WIDTHS}
        sizes={SHOT_SIZES}
        loading="eager"
        fetchpriority="high"
        style="view-transition-name: shot-facetflow"
      />
    </BrowserFrame>
  </article>
</section>

<style>
  .feature__card {
    --card-padding: clamp(1.25rem, 4vw, 2.5rem);

    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1.75rem;
    overflow: hidden;
    padding: var(--card-padding) var(--card-padding) 0;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 1.5);
    background: linear-gradient(160deg, rgb(255 50 88 / 0.18), var(--color-bg) 65%);
  }

  /* Wide screens: text on the left, and the screenshot runs off the card's
     bottom-right corner, so it can start near the top of the card. */
  @media (width >= 56rem) {
    .feature__card {
      grid-template-columns: minmax(15rem, 19rem) minmax(0, 1fr);
      gap: 2.5rem;
      padding-right: 0;
    }

    .feature__frame {
      align-self: end;
      border-right: 0;
      border-top-right-radius: 0;
    }
  }

  /* Pre-rendered grain stops the gradient from banding at no repaint cost. */
  .feature__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('/grain.png') repeat;
    opacity: 0.05;
    pointer-events: none;
  }

  .feature__text {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
  }

  @media (width >= 56rem) {
    .feature__text {
      padding-bottom: var(--card-padding);
    }
  }

  .feature__title {
    margin-top: -0.25rem;
    font-size: var(--text-h2);
  }

  /* Stretches the title link over the whole card, so the card is one click target
     while screen readers hear only the title. */
  .feature__link {
    text-decoration: none;
  }

  .feature__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  /* The link's own outline only goes where the card outline below can replace it. */
  @supports selector(:has(*)) {
    .feature__link:focus-visible {
      outline: none;
    }
  }

  .feature__card:has(.feature__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .feature__summary {
    color: var(--color-muted);
  }

  .feature__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-weight: 600;
    transition: color var(--duration-hover) var(--ease-out);
  }

  .feature__cta :global(svg) {
    transition: transform var(--duration-hover) var(--ease-out);
  }

  .feature__frame {
    border-bottom: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    transition: border-color var(--duration-hover) var(--ease-out);
  }

  .feature__shot {
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 56vh;
    object-fit: cover;
    object-position: left top;
  }

  /* Phones get a taller crop of the grid so the designs stay readable. */
  @media (width < 36rem) {
    .feature__shot {
      aspect-ratio: 4 / 5;
      object-position: 22% top;
    }
  }

  .feature__card:hover .feature__frame {
    border-color: rgb(255 255 255 / 0.28);
  }

  .feature__card:hover .feature__cta {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .feature__card:hover .feature__cta :global(svg) {
      transform: translateX(3px);
    }
  }
</style>
