---
import { PROFILE } from '../../data/profile';
import CopyEmailButton from '../CopyEmailButton.astro';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../Icon.astro';
---

<section class="intro container" aria-labelledby="intro-title">
  <p class="intro__now">
    <span class="intro__now-dot" aria-hidden="true"></span>
    <span><span class="intro__now-label">Now:</span> {PROFILE.now}</span>
  </p>
  <h1 class="intro__title" id="intro-title">{PROFILE.positioning}</h1>
  <p class="intro__summary">{PROFILE.summary}</p>

  <ul class="intro__links">
    <CopyEmailButton email={PROFILE.email} />
    <li>
      <ExternalLink href={PROFILE.githubUrl} class="intro__link">
        <Icon name="github" /> GitHub
      </ExternalLink>
    </li>
    <li>
      <ExternalLink href={PROFILE.linkedinUrl} class="intro__link">
        <Icon name="linkedin" /> LinkedIn
      </ExternalLink>
    </li>
    <li class="intro__phone-only"><a class="intro__link" href="#experience">Experience</a></li>
    <li class="intro__phone-only"><a class="intro__link" href="#work">Work</a></li>
    <li class="intro__phone-only"><a class="intro__link" href="#about">About</a></li>
  </ul>
</section>

<style>
  .intro {
    padding-block: clamp(2rem, 5vw, 3.5rem) 2rem;
  }

  .intro__now {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .intro__now-label {
    color: var(--color-text);
    font-weight: 600;
  }

  .intro__now-dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-tint);
    transform: translateY(-0.0625rem);
  }

  .intro__title {
    max-width: 22em;
    margin-top: 1rem;
    font-size: var(--text-display);
  }

  .intro__summary {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .intro__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .intro__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .intro__link:hover {
    color: var(--color-accent);
  }

  .intro__phone-only {
    display: none;
  }

  /* The header hides its section links on phones; they appear here instead. */
  @media (width < 40rem) {
    .intro__phone-only {
      display: list-item;
    }
  }
</style>
