---
import { Picture } from 'astro:assets';

import type { SelectedProject } from '../../data/projects';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../Icon.astro';
import Tags from '../Tags.astro';

interface Props {
  project: SelectedProject;
}

const { project } = Astro.props;
const CARD_IMAGE_WIDTHS = [400, 640, 960];
/* Mirrors the grid in WorkSection.astro: three columns from 64rem, two from 42rem. */
const CARD_IMAGE_SIZES = '(min-width: 64rem) 352px, (min-width: 42rem) 45vw, calc(100vw - 2rem)';
---

<article class="work-card">
  <div class="work-card__image-frame">
    <Picture
      class="work-card__image"
      src={project.image}
      alt={project.imageAlt}
      formats={['avif', 'webp']}
      widths={CARD_IMAGE_WIDTHS}
      sizes={CARD_IMAGE_SIZES}
      style={`object-position: ${project.imagePosition}`}
    />
  </div>
  <h3 class="work-card__title">
    <ExternalLink href={project.url} class="work-card__link">
      {project.name}
      <Icon name="arrow-up-right" size={18} class="work-card__arrow" />
    </ExternalLink>
  </h3>
  <p class="work-card__summary">{project.summary}</p>
  <p class="work-card__detail"><span class="work-card__label">My role:</span> {project.role}</p>
  <p class="work-card__detail work-card__outcome">
    <Icon name="check" size={14} class="work-card__check" />
    {project.outcome}
  </p>
  <Tags tags={project.tags} />
</article>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .work-card__image-frame {
    overflow: hidden;
    margin-bottom: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: border-color var(--duration-hover) var(--ease-out);
  }

  .work-card__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 300ms var(--ease-out);
  }

  .work-card__title {
    font-size: var(--text-lg);
  }

  .work-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    text-decoration: none;
  }

  /* The title link covers the whole card; see FeatureCard for the pattern. */
  .work-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @supports selector(:has(*)) {
    .work-card__link:focus-visible {
      outline: none;
    }
  }

  .work-card:has(.work-card__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: var(--radius);
  }

  .work-card__summary,
  .work-card__detail {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .work-card__label {
    color: var(--color-text);
    font-weight: 600;
  }

  .work-card__outcome {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--color-text);
  }

  .work-card__outcome :global(.work-card__check) {
    flex: none;
    color: var(--color-accent);
    transform: translateY(0.125rem);
  }

  .work-card :global(.tags) {
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .work-card:hover .work-card__image-frame {
    border-color: var(--color-border-strong);
  }

  .work-card:hover .work-card__link {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-card:hover .work-card__image {
      transform: scale(1.02);
    }

    .work-card :global(.work-card__arrow) {
      transition: transform var(--duration-hover) var(--ease-out);
    }

    .work-card:hover :global(.work-card__arrow) {
      transform: translate(2px, -2px);
    }
  }
</style>
