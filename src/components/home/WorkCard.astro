---
import { Picture } from 'astro:assets';

import { PROJECT_CARD_SIZE, type Project } from '../../data/projects';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../Icon.astro';
import Tags from '../Tags.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isWide = project.size === PROJECT_CARD_SIZE.wide;
const CARD_IMAGE_WIDTHS = [400, 640, 960];
/* Mirrors the grid in WorkSection.astro: two columns from 42rem in a 70rem container.
   A wide card puts its image beside the text, so the image is still one column wide. */
const CARD_IMAGE_SIZES = '(min-width: 72rem) 540px, (min-width: 42rem) 45vw, calc(100vw - 2rem)';
---

<article class:list={['work-card', { 'work-card--wide': isWide }]}>
  <div class="work-card__image-frame">
    <Picture
      class="work-card__image"
      src={project.image}
      alt={project.imageAlt}
      formats={['avif', 'webp']}
      widths={CARD_IMAGE_WIDTHS}
      sizes={CARD_IMAGE_SIZES}
      style={`object-position: ${project.imagePosition}; object-fit: ${project.imageFit ?? 'cover'}`}
    />
  </div>
  <div class="work-card__body">
    <h3 class="work-card__title">
      {
        project.url ? (
          <ExternalLink href={project.url} class="work-card__link">
            {project.name}
            <Icon name="arrow-up-right" size={18} class="work-card__arrow" />
          </ExternalLink>
        ) : (
          project.name
        )
      }
    </h3>
    <p class="work-card__summary">{project.summary}</p>
    <p class="work-card__detail"><span class="work-card__label">My role:</span> {project.role}</p>
    <p class="work-card__detail work-card__outcome">
      <Icon name="check" size={14} class="work-card__check" />
      {project.outcome}
    </p>
    <Tags tags={project.tags} />
    {
      project.codeUrl && (
        <p class="work-card__code">
          <ExternalLink href={project.codeUrl} class="work-card__code-link">
            <Icon name="github" size={14} /> Code
          </ExternalLink>
        </p>
      )
    }
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .work-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* A wide card takes the whole row: image on the left, text on the right.
     Its two halves use the grid's own column widths and gap, so the image
     lines up exactly with the cards below it. */
  @media (width >= 42rem) {
    .work-card--wide {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
      align-items: center;
    }
  }

  .work-card__image-frame {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: border-color var(--duration-hover) var(--ease-out);
  }

  .work-card__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 300ms var(--ease-out);
  }

  .work-card__title {
    font-size: var(--text-lg);
  }

  .work-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    text-decoration: none;
  }

  /* The title link covers the whole card; see FeatureCard for the pattern. */
  .work-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @supports selector(:has(*)) {
    .work-card__link:focus-visible {
      outline: none;
    }
  }

  .work-card:has(.work-card__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: var(--radius);
  }

  .work-card__summary,
  .work-card__detail {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .work-card__label {
    color: var(--color-text);
    font-weight: 600;
  }

  .work-card__outcome {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--color-text);
  }

  .work-card__outcome :global(.work-card__check) {
    flex: none;
    color: var(--color-accent);
    transform: translateY(0.125rem);
  }

  .work-card :global(.tags) {
    margin-top: auto;
    padding-top: 0.25rem;
  }


  /* Sits above the title link's card-wide click area, so it stays its own target. */
  .work-card__code {
    position: relative;
    z-index: 1;
  }

  .work-card__code :global(.work-card__code-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .work-card__code :global(.work-card__code-link:hover) {
    color: var(--color-accent);
  }

  .work-card:hover .work-card__image-frame {
    border-color: var(--color-border-strong);
  }

  .work-card:hover .work-card__link {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-card:hover .work-card__image {
      transform: scale(1.02);
    }

    .work-card :global(.work-card__arrow) {
      transition: transform var(--duration-hover) var(--ease-out);
    }

    .work-card:hover :global(.work-card__arrow) {
      transform: translate(2px, -2px);
    }
  }
</style>
