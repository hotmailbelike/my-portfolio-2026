---
import { PROJECTS } from '../../data/projects';
import SectionHeading from '../SectionHeading.astro';
import WorkCard from './WorkCard.astro';
---

<section class="section container" aria-labelledby="projects">
  <SectionHeading id="projects" title="Projects" />

  <div class="work-grid">
    {PROJECTS.map((project) => <WorkCard project={project} />)}
  </div>
</section>

<style>
  /* One column on phones, two from 42rem. A wide card (see WorkCard.astro)
     takes a whole row, so every row below it holds two cards of the same shape.
     PROJECTS lists professional work first, so it stays on top. */
  .work-grid {
    display: grid;
    gap: 3.5rem 2.5rem;
  }

  @media (width >= 42rem) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
