---
import AboutSection from '../components/home/AboutSection.astro';
import ContactSection from '../components/home/ContactSection.astro';
import ExperienceSection from '../components/home/ExperienceSection.astro';
import FactsStrip from '../components/home/FactsStrip.astro';
import FeatureCard from '../components/home/FeatureCard.astro';
import Intro from '../components/home/Intro.astro';
import WorkSection from '../components/home/WorkSection.astro';
import { PROFILE } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`${PROFILE.name} · ${PROFILE.role}`} description={PROFILE.positioning}>
  <Intro />
  <FeatureCard />
  <FactsStrip />
  <ExperienceSection />
  <WorkSection />
  <AboutSection />
  <ContactSection />
</BaseLayout>
