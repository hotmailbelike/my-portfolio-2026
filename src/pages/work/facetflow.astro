---
import { Picture } from 'astro:assets';

import BrowserFrame from '../../components/BrowserFrame.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import Icon from '../../components/Icon.astro';
import Tags from '../../components/Tags.astro';
import ScreenGallery from '../../components/work-page/ScreenGallery.astro';
import { FACETFLOW } from '../../data/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';

const HERO_WIDTHS = [640, 960, 1280, 1800, 2400];
const HERO_SIZES = '(min-width: 72rem) 1120px, calc(100vw - 2rem)';
---

<BaseLayout title={`${FACETFLOW.name} · Abdullah Omar`} description={FACETFLOW.summary}>
  <article class="work-page">
    <header class="container work-page__header">
      <a class="work-page__back" href="/#projects">
        <Icon name="arrow-left" size={14} /> All projects
      </a>
      <p class="eyebrow">Software Engineer · {FACETFLOW.years}</p>
      <h1 class="work-page__title">{FACETFLOW.name}</h1>
      <p class="work-page__lede">{FACETFLOW.summary}</p>

      <dl class="work-page__meta">
        <div>
          <dt class="eyebrow">Role</dt>
          <dd>{FACETFLOW.role}</dd>
        </div>
        <div>
          <dt class="eyebrow">Stack</dt>
          <dd><Tags tags={FACETFLOW.tags} /></dd>
        </div>
        <div>
          <dt class="eyebrow">Live</dt>
          <dd>
            <ExternalLink href={FACETFLOW.url} class="work-page__live">
              facetflow.io <Icon name="arrow-up-right" size={14} />
            </ExternalLink>
          </dd>
        </div>
      </dl>
    </header>

    <div class="container">
      <BrowserFrame>
        <Picture
          class="work-page__hero"
          src={FACETFLOW.hero.image}
          alt={FACETFLOW.hero.alt}
          formats={['avif', 'webp']}
          widths={HERO_WIDTHS}
          sizes={HERO_SIZES}
          loading="eager"
          fetchpriority="high"
          style="view-transition-name: shot-facetflow"
        />
      </BrowserFrame>
    </div>

    <div class="container work-page__body">
      <section aria-labelledby="product">
        <h2 id="product">The product</h2>
        <p>
          Taking a piece of jewelry from a customer's idea to something priced and ready to manufacture means sketches,
          CAD, stone sourcing and spreadsheets, each in a different tool and often with a different person. Every
          revision goes round the same loop, and quoting a price can take days.
        </p>
        <p>
          Facet Flow puts that whole path in one workspace. A jeweler starts from a sketch, a photo or a few words,
          refines the design, sees it worn, and gets drawings, CAD and a price for each quality tier.
        </p>
      </section>

      <section aria-labelledby="what-i-worked-on">
        <h2 id="what-i-worked-on">What I worked on</h2>
        <p>
          I'm a software engineer on a small team that works closely with the founders. Since joining in January 2025
          I have worked on almost every part of the product, usually end to end, from the interface to the services
          behind it. The main areas:
        </p>
        <div class="areas">
          {
            FACETFLOW.contributionAreas.map((area) => (
              <section class="areas__group" aria-label={area.title}>
                <h3 class="areas__title">{area.title}</h3>
                <ul class="areas__list">
                  {area.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="how-i-work">
        <h2 id="how-i-work">How I work</h2>
        <dl class="principles">
          {
            FACETFLOW.workingPrinciples.map((principle) => (
              <div class="principles__item">
                <dt class="principles__title">{principle.title}</dt>
                <dd class="principles__text">{principle.text}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    <section class="container work-page__inside" aria-labelledby="inside">
      <h2 id="inside">A look inside</h2>
      <p class="work-page__inside-note">
        A small sample. {FACETFLOW.name} is a large product, with dedicated workflows for design, engineering,
        costing, merchandising and sales; a few screens can't show it all. Select any image to see it full size.
      </p>

      <h3 class="work-page__gallery-title">In the app</h3>
      <ScreenGallery items={FACETFLOW.screens} variant="screens" />

      <h3 class="work-page__gallery-title">What it makes</h3>
      <ScreenGallery items={FACETFLOW.outputs} variant="outputs" />

      <aside class="more-workflows" aria-labelledby="more-workflows-title">
        <p class="more-workflows__title" id="more-workflows-title">And much more</p>
        <p class="more-workflows__list">{FACETFLOW.otherWorkflows.join(' · ')}</p>
        <ExternalLink href={FACETFLOW.workflowsUrl} class="work-page__live">
          See every workflow on facetflow.io <Icon name="arrow-up-right" size={14} />
        </ExternalLink>
      </aside>
    </section>

    <footer class="container work-page__footer">
      <a class="work-page__back" href="/#projects">
        <Icon name="arrow-left" size={14} /> Back to all projects
      </a>
      <ExternalLink href={FACETFLOW.url} class="work-page__live">
        Visit facetflow.io <Icon name="arrow-up-right" size={14} />
      </ExternalLink>
    </footer>
  </article>
</BaseLayout>

<style>
  .work-page__header {
    padding-block: clamp(2rem, 5vw, 3.5rem) 2.5rem;
  }

  .work-page__back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 2rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .work-page__back:hover {
    color: var(--color-text);
  }

  .work-page__title {
    margin-top: 0.5rem;
    font-size: var(--text-display);
  }

  .work-page__lede {
    max-width: 44rem;
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .work-page__meta {
    display: grid;
    gap: 1.25rem 3rem;
    margin-top: 2rem;
  }

  @media (width >= 48rem) {
    .work-page__meta {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.2fr) auto;
    }
  }

  .work-page__meta dd {
    margin-top: 0.5rem;
  }

  .work-page__live {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 600;
  }

  .work-page__hero {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: left top;
  }

  .work-page__body {
    display: grid;
    gap: 4rem;
    max-width: min(100% - 2 * var(--gutter), 55rem);
    padding-top: var(--space-section);
  }

  .work-page h2 {
    margin-bottom: 1rem;
    font-size: var(--text-h2);
  }

  .work-page__body section > p {
    max-width: 44rem;
    margin-bottom: 1.25rem;
    color: var(--color-muted);
  }

  /* My part: one card per product area, two across on wider screens. */
  .areas {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (width >= 40rem) {
    .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .areas__group {
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .areas__title {
    margin-bottom: 0.75rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0;
  }

  .areas__list {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.125rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .areas__list li::marker {
    color: var(--color-accent);
  }

  .principles {
    display: grid;
  }

  .principles__item {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1.125rem;
    border-top: 1px solid var(--color-border);
  }

  .principles__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  @media (width >= 48rem) {
    .principles__item {
      grid-template-columns: 15rem 1fr;
    }
  }

  .principles__title {
    font-weight: 600;
  }

  .principles__text {
    color: var(--color-muted);
  }

  /* A look inside spans the full container so the image grids have room. */
  .work-page__inside {
    padding-top: var(--space-section);
  }

  .work-page__inside-note {
    max-width: 44rem;
    color: var(--color-muted);
  }

  .work-page__gallery-title {
    margin-block: 2.5rem 1rem;
    font-size: var(--text-lg);
  }

  .more-workflows {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
  }

  .more-workflows__title {
    font-weight: 600;
  }

  .more-workflows__list {
    margin-bottom: 0.5rem;
    color: var(--color-muted);
  }

  .work-page__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: var(--space-section);
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .work-page__footer .work-page__back {
    margin-bottom: 0;
  }
</style>
